// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String     @id
  name           String
  title          String?
  firstName      String?    @map("first_name")
  lastName       String?    @map("last_name")
  email          String
  emailVerified  Boolean    @default(false)
  image          String?
  nicNumber      String?    @unique @map("nic_number")
  mobileNumber   String?    @map("mobile_number")
  position       String?
  role           String?    @default("passenger")
  banned         Boolean?   @default(false)
  banReason      String?
  banExpires     DateTime?
  impersonatedBy String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  sessions       Session[]
  accounts       Account[]
  allocations    SeatSegmentAllocation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Station {
  id                 String   @id @default(uuid())
  name               String
  code               String   @unique
  location           String?
  cumulativeDistance Float    @default(0) @map("cumulative_distance")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  startLines           Line[]                  @relation("StartStation")
  endLines             Line[]                  @relation("EndStation")
  lineIntermediaries     LineStation[]
  allocationOrigins      SeatSegmentAllocation[] @relation("AllocationOrigin")
  allocationDestinations SeatSegmentAllocation[] @relation("AllocationDestination")

  @@map("station")
}

model Line {
  id             String   @id @default(uuid())
  name           String
  startStationId String   @map("start_station_id")
  startStation   Station  @relation("StartStation", fields: [startStationId], references: [id])
  endStationId   String   @map("end_station_id")
  endStation     Station  @relation("EndStation", fields: [endStationId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stations  LineStation[]
  trains    Train[]
  schedules Schedule[]

  @@map("line")
}

model LineStation {
  id                String  @id @default(uuid())
  lineId            String  @map("line_id")
  line              Line    @relation(fields: [lineId], references: [id], onDelete: Cascade)
  stationId         String  @map("station_id")
  station           Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
  position          Int
  distanceFromStart Float   @default(0) @map("distance_from_start")

  @@unique([lineId, position])
  @@map("line_station")
}

model Coach {
  id                String   @id @default(uuid())
  identifier        String   @unique
  seatCount         Int      @map("seat_count")
  isReserved        Boolean  @default(false) @map("is_reserved")
  coachClass        String   @map("coach_class")
  seatConfiguration String   @map("seat_configuration")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trainCoaches TrainCoach[]
  allocations  SeatSegmentAllocation[]

  @@map("coach")
}

model Train {
  id          String   @id @default(uuid())
  name        String
  trainNumber String   @unique @map("train_number")
  lineId      String?  @map("line_id")
  line        Line?    @relation(fields: [lineId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coaches   TrainCoach[]
  schedules Schedule[]

  @@map("train")
}

model TrainCoach {
  id       String @id @default(uuid())
  trainId  String @map("train_id")
  train    Train  @relation(fields: [trainId], references: [id], onDelete: Cascade)
  coachId  String @map("coach_id")
  coach    Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  position Int

  @@unique([trainId, position])
  @@map("train_coach")
}

model Schedule {
  id            String   @id @default(uuid())
  lineId        String   @map("line_id")
  line          Line     @relation(fields: [lineId], references: [id], onDelete: Cascade)
  trainId       String   @map("train_id")
  train         Train    @relation(fields: [trainId], references: [id], onDelete: Cascade)
  departureTime DateTime @map("departure_time")
  arrivalTime   DateTime @map("arrival_time")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  allocations SeatSegmentAllocation[]

  @@map("schedule")
}

model SeatSegmentAllocation {
  id                   String    @id @default(uuid())
  scheduleId           String    @map("schedule_id")
  schedule             Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  coachId              String    @map("coach_id")
  coach                Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  seatNumber           Int       @map("seat_number")
  originStationId      String    @map("origin_station_id")
  originStation        Station   @relation("AllocationOrigin", fields: [originStationId], references: [id])
  destinationStationId String    @map("destination_station_id")
  destinationStation   Station   @relation("AllocationDestination", fields: [destinationStationId], references: [id])
  originPosition       Int       @map("origin_position")
  destinationPosition  Int       @map("destination_position")
  status               String    @default("ACTIVE")
  expiresAt            DateTime? @map("expires_at")
  bookingReference     String?   @unique @map("booking_reference")
  passengerName        String?   @map("passenger_name")
  passengerEmail       String?   @map("passenger_email")
  passengerPhone       String?   @map("passenger_phone")
  userId               String?   @map("user_id")
  user                 User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  fareAmount           Float     @default(0) @map("fare_amount")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([scheduleId, coachId, seatNumber])
  @@index([status])
  @@map("seat_segment_allocation")
}

model FareSettings {
  id                String   @id @default("singleton")
  flatBookingFee    Float    @default(50) @map("flat_booking_fee")
  ratePerKm         Float    @default(10) @map("rate_per_km")
  offPeakMultiplier Float    @default(1) @map("off_peak_multiplier")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("fare_settings")
}

model CoachClassFareMultiplier {
  id         String @id @default(uuid())
  coachClass String @unique @map("coach_class")
  multiplier Float  @default(1)

  @@map("coach_class_fare_multiplier")
}

model PeakHourRule {
  id         String   @id @default(uuid())
  name       String
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  multiplier Float    @default(1.25)
  daysOfWeek Int[]    @default([1, 2, 3, 4, 5]) @map("days_of_week")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("peak_hour_rule")
}
