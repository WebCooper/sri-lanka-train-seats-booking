# =============================================================================
# Docker Compose environment
# Copy to .env before running:  cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=trainbooking
POSTGRES_PASSWORD=trainbooking
POSTGRES_DB=train_booking
POSTGRES_PORT=5432

# Used when running the backend locally (outside Docker).
# Inside Docker Compose this is overridden to use the postgres service hostname.
DATABASE_URL=postgresql://trainbooking:trainbooking@localhost:5432/train_booking?schema=public

# --- NestJS backend ---
PORT=5000
NODE_ENV=production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Next.js web ---
# Browser-facing API URL (baked into the image at build time).
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# --- Vite admin ---
# Browser-facing API URL (baked into the image at build time).
ADMIN_PORT=5173
VITE_API_BASE_URL=http://localhost:5000
