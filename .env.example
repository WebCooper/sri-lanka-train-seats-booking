# PostgreSQL
POSTGRES_USER=trainbooking
POSTGRES_PASSWORD=trainbooking
POSTGRES_DB=train_booking
DATABASE_URL=postgresql://trainbooking:trainbooking@localhost:5432/train_booking?schema=public

# NestJS API
PORT=3001
NODE_ENV=development
FARE_RATE_PER_KM_CENTS=250
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Next.js web client
NEXT_PUBLIC_API_URL=http://localhost:3001

# Vite admin client
VITE_API_URL=http://localhost:3001
